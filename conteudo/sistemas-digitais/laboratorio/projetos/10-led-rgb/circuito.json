{
  "schemaVersion": 1,
  "id": "led-rgb",
  "title": "Projeto 10 · LED RGB",
  "level": "intermediario",
  "board": "arduino-uno-r3",
  "components": [
    {
      "id": "uno",
      "type": "arduino-uno-r3",
      "x": 40,
      "y": 110
    },
    {
      "id": "pb1",
      "type": "protoboard-400",
      "x": 400,
      "y": 60
    },
    {
      "id": "rgb1",
      "type": "led-rgb",
      "x": 0,
      "y": 0,
      "mount": {
        "r": "pb1:h15",
        "comum": "pb1:h16",
        "g": "pb1:h17",
        "b": "pb1:h18"
      }
    },
    {
      "id": "r1",
      "type": "resistor",
      "x": 0,
      "y": 0,
      "props": {
        "ohms": 220
      },
      "mount": {
        "1": "pb1:c15",
        "2": "pb1:g15"
      },
      "rot": 90
    },
    {
      "id": "r2",
      "type": "resistor",
      "x": 0,
      "y": 0,
      "props": {
        "ohms": 220
      },
      "mount": {
        "1": "pb1:c17",
        "2": "pb1:g17"
      },
      "rot": 90
    },
    {
      "id": "r3",
      "type": "resistor",
      "x": 0,
      "y": 0,
      "props": {
        "ohms": 220
      },
      "mount": {
        "1": "pb1:c18",
        "2": "pb1:g18"
      },
      "rot": 90
    }
  ],
  "connections": [
    {
      "id": "w1",
      "from": "uno:D9",
      "to": "pb1:a15",
      "color": "vermelho"
    },
    {
      "id": "w2",
      "from": "uno:D10",
      "to": "pb1:a17",
      "color": "verde"
    },
    {
      "id": "w3",
      "from": "uno:D11",
      "to": "pb1:a18",
      "color": "azul"
    },
    {
      "id": "w4",
      "from": "pb1:j16",
      "to": "uno:GND.2",
      "color": "preto"
    }
  ],
  "sketch": "rgb.ino",
  "capabilities": [
    "pwm",
    "serial"
  ],
  "metadata": {
    "instrucoes": "LED RGB de cátodo comum: cada cor (pinos 9, 10 e 11, com PWM) passa pelo seu resistor de 220 Ω, e o comum vai ao GND.\n\nExecute: uma cor por segundo, e a aba Serial diz qual."
  }
}
